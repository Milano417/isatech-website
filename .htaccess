Options -Indexes
DirectoryIndex index.html index.php
# Tout le site tient dans index.html : une adresse inconnue renvoie vers l'accueil
ErrorDocument 404 /index.html

# Anciennes adresses (une page par fichier) → nouvelles adresses
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^a-propos\.html$ /#/a-propos [R=301,NE,L]
    RewriteRule ^formations\.html$ /#/formations [R=301,NE,L]
    RewriteRule ^admission\.html$ /#/admission [R=301,NE,L]
    RewriteRule ^actualites\.html$ /#/actualites [R=301,NE,L]
    RewriteRule ^galerie\.html$ /#/galerie [R=301,NE,L]
    RewriteRule ^contact\.html$ /#/contact [R=301,NE,L]
    RewriteCond %{QUERY_STRING} (?:^|&)id=([^&]+)
    RewriteRule ^formation\.html$ /#/formation/%1? [R=301,NE,L]
    RewriteCond %{QUERY_STRING} (?:^|&)id=([^&]+)
    RewriteRule ^article\.html$ /#/article/%1? [R=301,NE,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
